---

<section>
  {title && (
  <h2>{title}</h2>
  <hr/>
  )}
  <slot />
</section>

<script>
  // se ejecuta en el cliente <----
</script>

<style>
  section {
    max-width: 700px;
    margin: 0 auto 48px;
  }

  h2 {
    margin-bottom: 8px;
    font-weight: 700;
    line-height: 1.6;
    font-size: 1.6rem;
    color: var(--color-custom-blue-700);
  }

  hr{
    width: 40px;
    height: 4px;
    background: var(--color-custom-blue-300);
    margin-bottom: 16px;
  }

  @media print {
    section {
      max-width: none;
      margin: 0 0 6mm;
    }

    h2 {
      margin-bottom: 1.5mm;
      font-size: 13pt;
      line-height: 1.25;
    }

    hr {
      width: 12mm;
      height: 2pt;
      margin-bottom: 3mm;
      break-after: avoid;
