---
import { basics } from '@cv'
import Section from '@/components/Section.astro'
import Contacts from '@/components/sections/Contacts.astro'
import WorldMap from '@/icons/WorldMap.astro'

const { name, label, image, location } = basics
---

<Section>
	<div class="container">
		<div class="bar"></div>
		<div class="info">
			<h1>{name}</h1>
			<h3>{label}</h3>
      <div class="location">
        <WorldMap/> 
        {location.city && <span>{location.city},</span>}
        {location.region && <span>{location.region},</span>}
        {location.countryCode && <span>{location.countryCode}</span>}
      </div>
      <Contacts/>
		</div>
    <div class="avatar">
      <img src={image} alt="Profile picture" />
    </div>
	</div>
</Section>

<style>
	.container {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: start;
		gap: 1rem;
	}

	.bar {
		width: 4px;
		height: var(--hero-card-height);
		background: var(--color-custom-blue-300);
		border-radius: 2px;
	}

	.info {
		display: flex;
		flex-direction: column;
    align-items: flex-start;
    justify-content: center;
		gap: 16px;
		padding-right: 32px;
    margin-right: auto;
	}

  .location {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

	img {
		aspect-ratio: 1 / 1;
		object-fit: cover;
		width: 128px;
		border-radius: 16px;
	}

	span {
		display: flex;
		align-items: center;
		gap: 0.25rem;
		font-size: 0.85rem;
		letter-spacing: -0.05rem;
	}

	@media print {
		.container {
			align-items: flex-start;
			gap: 6mm;
		}

		.bar {
			align-self: stretch;
			height: auto;
			min-height: 38mm;
		}

		.info {
			gap: 3mm;
			padding-right: 0;
		}

		h1 {
			font-size: 22pt;
		}

		h3 {
			font-size: 11pt;
		}

		.location {
			font-size: 8pt;
			gap: 2mm;
		}

		.location svg {
			display: none !important;
		}

		img {
			width: 24mm;
			border-radius: 3mm;
		}

		span {
			font-size: 8pt;
			letter-spacing: 0;
		}
	}
</style>
