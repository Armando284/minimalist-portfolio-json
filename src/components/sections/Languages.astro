---
import { languages } from '@cv'
import Section from '@/components/Section.astro'
---

<Section title="Languages">
	<div class="container">
		{
			languages &&
				languages.map((language) => (
					<span class="tag">
						{language.language}: {language.fluency}
					</span>
				))
		}
	</div>

	<style>
		.container {
			width: 100%;
			display: flex;
			align-items: start;
			gap: 16px;
			font-size: 0.8rem;
		}

		@media print {
			.container {
				gap: 3mm;
				font-size: 8pt;
			}
		}
	</style>
</Section>
